# ── Server ────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development      # set to 'production' on Render

# ── MongoDB ───────────────────────────────────────────────────
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017/king-zevi   # optional — defaults to 'mongodb://localhost:27017/solace'
DB_NAME=king-zevi         # optional — defaults to 'solace'

# ── Security ──────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── CORS (production only) ────────────────────────────────────
# Your Netlify frontend URL, e.g. https://solace-music.netlify.app
ALLOWED_ORIGIN=https://kingzevi.com
