# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Server
PORT=3000
NODE_ENV=production          # change to 'production' on Render

# Security — use a long random string in production
JWT_SECRET=PDJMGKDNKMFkNKDSLKNKklloooopU9REJFNU9ND939U4HNF93HNDONDNSII8

# Database — leave empty for local (uses ./solace.db)
# On Render, set this to /data/solace.db (persistent disk)
DB_PATH=/data/solace.db

# CORS — your Netlify frontend URL (production only)
# Example: https://solace-music.netlify.app
ALLOWED_ORIGIN=https://kingzevi.com
